# RPCEdge Yellowstone endpoint used by observation collectors.
RPCEDGE_GRPC_URL=https://grpc.rpcedge.com

# Yellowstone x-token for processed and SubscribeDeshred sources.
YELLOWSTONE_X_TOKEN=replace-me

# Optional Helius Sender API key (only for accounts approved for higher TPS).
HELIUS_SENDER_API_KEY=replace-me

# Astralane Iris API key, sent as the api-key query parameter.
ASTRALANE_API_KEY=replace-me
